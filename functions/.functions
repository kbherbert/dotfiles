# Weather
weather() {
    curl -s "https://wttr.in/${1:-Louisville}?format=v2"
}

# IP addresses
ip-public() {
    curl ipecho.net/plain; echo
}

ip-private() {
    ifconfig -l | xargs -n1 ipconfig getifaddr
    return zsh
}

batdiff() {
    git diff --name-only --relative --diff-filter=d | xargs bat --diff
}

# "fd": find directory
# Find and cd into the selected directory using fzf, only showing the first and second
# level sub-directories and not showing the directories within those.
# Excludes .git directories.
fd() {
    DIR=$(
          find ~/Workspace ~/Developer \
               -maxdepth 3 \
               -name ".git" -prune -o \
               -type d -print 2> /dev/null | fzf
         ) \
    && cd "$DIR"
}

so() {
    source ~/.zshrc
}
